async function handleGenerateDocument() {
  const customer = {
    name: el.customerName.value.trim(),
    contact: el.customerContact.value.trim(),
    address: el.customerAddress.value.trim(),
    attn: el.customerAttn.value.trim(),
  };

  if (!customer.name) {
    alert("Please enter the customer name before generating the document.");
    return;
  }
  if (quoteItems.length === 0) {
    alert("Add at least one item to the quote first.");
    return;
  }

  const originalLabel = el.generateDocBtn.textContent;
  el.generateDocBtn.disabled = true;
  el.generateDocBtn.textContent = "Generating...";

  try {
    const serial = nextQuotationSerial();
    const delivery = getDeliveryFee();
    const html = await buildQuotationHtml(customer, quoteItems, serial, delivery);

    // Open in new window and trigger print -> user saves as PDF
    const printWindow = window.open("", "_blank");
    printWindow.document.open();
    printWindow.document.write(html);
    printWindow.document.close();
    printWindow.focus();

    // Wait for all images to load before printing
    function waitForImagesAndPrint() {
      try {
        const imgs = printWindow.document.images;
        let allLoaded = imgs.length > 0;
        for (let i = 0; i < imgs.length; i++) {
          if (!imgs[i].complete || imgs[i].naturalWidth === 0) {
            allLoaded = false;
            break;
          }
        }
        if (allLoaded) {
          printWindow.print();
        } else {
          setTimeout(waitForImagesAndPrint, 300);
        }
      } catch (e) {
        // Fallback: print after timeout
        setTimeout(() => { try { printWindow.print(); } catch(err) {} }, 2000);
      }
    }
    // Start checking after a short delay to let the DOM parse
    setTimeout(waitForImagesAndPrint, 500);

    // Auto-save to Supabase
    saveQuotationToHistory(customer, quoteItems, serial, delivery).catch((err) => {
      console.warn("History save failed (doc still downloaded ok):", err);
    });
  } finally {
    el.generateDocBtn.disabled = false;
    el.generateDocBtn.textContent = originalLabel;
  }
}


// Insert one row into the Supabase `quotations` table. Uses the user's LOCAL
// date (not UTC) for quote_date so day-buckets match the operator's calendar
// even for quotations generated late in the evening in UTC+8.
async function saveQuotationToHistory(customer, items, serial, delivery) {
  if (!window.SB) return; // Supabase client unavailable (offline / CDN blocked)

  const now = new Date();
  const localDate =
    now.getFullYear() + "-" +
    String(now.getMonth() + 1).padStart(2, "0") + "-" +
    String(now.getDate()).padStart(2, "0");

  const rowItems = items.map((it) => ({
    sku: it.sku,
    name: String(it.name).split("\n").slice(0, 2).join(" / "), // SKU / product name only
    qty: it.qty,
    unit_usd: Number(it.price) || 0,
    unit_myr: finalUnitPrice(it.price),
    total_myr: it.total,
  }));

  const itemCount = items.reduce((n, it) => n + (Number(it.qty) || 0), 0);
  const itemsSum = items.reduce((n, it) => n + it.total, 0);
  const grandTotal = itemsSum + (delivery ? delivery.price : 0);

  const { error } = await window.SB.from("quotations").insert({
    serial,
    quote_date: localDate,
    customer_name: customer.name || null,
    customer_attn: customer.attn || null,
    items: rowItems,
    item_count: itemCount,
    delivery_desc: delivery ? (delivery.desc || null) : null,
    delivery_price: delivery ? delivery.price : null,
    grand_total: grandTotal,
  });
  if (error) throw error;
}

